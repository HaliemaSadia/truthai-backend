# ─── Server Configuration ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_URL=https://your-backend-app.onrender.com
FRONTEND_URL=https://halima-ai.supertechholding.com

# Comma-separated list of allowed CORS origins (Include production frontend URL)
ALLOWED_ORIGINS=https://halima-ai.supertechholding.com,http://localhost:5173,http://localhost:3000,http://localhost:4173

# ─── OpenAI API Configuration ───────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ─── Supabase Configuration (Server-side / service role) ─────────────────────
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── JWT Authentication Secrets ─────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-64-character-hex-access-secret-here
JWT_REFRESH_SECRET=your-64-character-hex-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth 2.0 (Optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-app.onrender.com/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── SMTP / Email Service (Optional) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TruthAI <noreply@your-domain.com>

# ─── Stripe Payments (Optional) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PRICE_ID=price_key
STRIPE_WEBHOOK_SECRET=whsec_key
PUBLIC_BASE_URL=https://your-backend-app.onrender.com

# ─── Logging & Frontend Base URL ────────────────────────────────────────────
LOG_LEVEL=info
VITE_API_BASE_URL=https://your-backend-app.onrender.com
